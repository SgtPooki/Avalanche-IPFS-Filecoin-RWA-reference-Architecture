{
  "name": "avalanche-ipfs-filecoin-rwa-reference-architecture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --project browser",
    "dataset": "tsx scripts/generate-dataset.ts",
    "test:unit": "vitest run --project node --project browser",
    "test:files": "vitest run --project files",
    "spike:calibration": "tsx --env-file=.env scripts/spike-calibration.ts",
    "spike:fuji": "tsx --env-file=.env scripts/spike-fuji.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "verify": "tsx scripts/verify.ts",
    "spike:browser": "node scripts/spike-browser-download.mjs",
    "publish": "tsx --env-file=.env scripts/publish.ts",
    "share": "tsx scripts/build-share-page.ts"
  },
  "dependencies": {
    "@filoz/synapse-core": "^0.9.0",
    "@filoz/synapse-sdk": "^2.0.0",
    "@helia/unixfs": "^7.2.1",
    "blockstore-core": "^6.1.3",
    "filecoin-pin": "^2.0.1",
    "multiformats": "^14.0.0",
    "pino": "^10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.55.16"
  },
  "devDependencies": {
    "@ipld/car": "^5.4.7",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser-playwright": "^4.0.7",
    "playwright": "^1.56.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.8"
  }
}
